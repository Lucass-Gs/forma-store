{
  "name": "forma-store",
  "version": "0.1.0",
  "private": true,
  "overrides": { "multer": "2.3.0" },
  "scripts": {
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "next build apps/web",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "db:migrate": "node dist/migrate.js",
    "db:seed": "node dist/seed.js",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "test:resilience": "node tests/resilience.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pg": "^8.23.0",
    "zod": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "next": "^16.3.3",
    "@aws-sdk/client-sqs": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.63.0"
  }
}
